# Place this file at the monorepo root (next to package.json). Vite loads it from there.
#
# Supabase (https://supabase.com/dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# (Express uses ANON key to validate Bearer JWTs on /api/admin/*; SERVICE_ROLE for admin API + DB.)

# Create phone users (server): npm run create-user -- "+15551234567" "password"  (in server/)

# Vite client — only vars prefixed with VITE_ are exposed to the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API server
PORT=8000
